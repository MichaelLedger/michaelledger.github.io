{
  "name": "json-studio",
  "version": "1.0.0",
  "private": true,
  "description": "JSON Studio — static JSON viewer with CodeMirror 6 editor",
  "scripts": {
    "build:editor": "esbuild js/editor.js --bundle --format=iife --global-name=JsonStudioEditor --outfile=vendor/codemirror/editor.bundle.js --minify",
    "build": "npm run build:editor"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.1"
  }
}
